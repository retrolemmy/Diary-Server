[Unit]
Description=Diary Server for the retro Diary apps
After=network.target

[Service]
User=retro
ExecStart=/usr/bin/python3 /usr/local/bin/diary_server.py --dir /data/retronas/diary
# A key the clients must send, if /etc/diary-server.env exists (see README)
EnvironmentFile=-/etc/diary-server.env
Restart=on-failure

[Install]
WantedBy=multi-user.target
